local NaJa = {}
NaJa.__index = NaJa

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local Theme = {
	Background = Color3.fromRGB(18, 18, 18),
	Section = Color3.fromRGB(28, 28, 28),
	Element = Color3.fromRGB(34, 34, 34),
	ElementHover = Color3.fromRGB(42, 42, 42),
	ElementActive = Color3.fromRGB(50, 50, 50),
	Border = Color3.fromRGB(46, 46, 46),
	BorderHover = Color3.fromRGB(68, 68, 68),
	Text = Color3.fromRGB(235, 235, 235),
	TextMuted = Color3.fromRGB(160, 160, 160),
	TextDark = Color3.fromRGB(105, 105, 105),
	Accent = Color3.fromRGB(88, 101, 242),
	AccentHover = Color3.fromRGB(110, 125, 255),
	Error = Color3.fromRGB(212, 63, 63)
}

local function New(className, props)
	local obj = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				obj[k] = v
			end
		end
		if props.Parent then
			obj.Parent = props.Parent
		end
	end
	return obj
end

local function Tween(obj, props, duration)
	duration = duration or 0.2
	local tween = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function MakeDraggable(frame, handle)
	handle = handle or frame
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function MakeResizable(frame, handle, minSize, onChange)
	handle = handle or frame
	minSize = minSize or Vector2.new(520, 360)

	local resizing = false
	local dragInput = nil
	local dragStart = nil
	local startSize = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			dragStart = input.Position
			startSize = frame.AbsoluteSize
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if resizing and input == dragInput then
			local delta = input.Position - dragStart
			local newW = math.max(minSize.X, startSize.X + delta.X)
			local newH = math.max(minSize.Y, startSize.Y + delta.Y)
			frame.Size = UDim2.fromOffset(newW, newH)
			if onChange then
				onChange(newW, newH)
			end
		end
	end)
end

pcall(function()
	local old = CoreGui:FindFirstChild("NaJaUI")
	if old then
		old:Destroy()
	end
end)

function NaJa:NaJa(config)
	return self:CreateWindow(config)
end

function NaJa:CreateWindow(config)
	config = config or {}

	local function readSize(size)
		if typeof(size) == "Vector2" then
			return size.X, size.Y
		end
		if type(size) == "table" then
			return tonumber(size.X or size[1]), tonumber(size.Y or size[2])
		end
		return nil, nil
	end

	local title = config.Title or config.Name or "NaJa"
	local subtitle = config.Desc or config.SubTitle or config.Description or "by NaJa"
	local keybind = config.Keybind or config.ToggleKey or Enum.KeyCode.RightShift
	local defaultW, defaultH = readSize(config.Size)
	defaultW = defaultW or 700
	defaultH = defaultH or 460

	local screenGui = New("ScreenGui", {
		Name = "NaJaUI",
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ResetOnSpawn = false,
		DisplayOrder = 9999,
		IgnoreGuiInset = true
	})

	pcall(function()
		screenGui.Parent = CoreGui
	end)

	if not screenGui.Parent then
		screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end

	local notifyHolder = New("Frame", {
		Parent = screenGui,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.new(0, 320, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y
	})

	local notifyLayout = New("UIListLayout", {
		Parent = notifyHolder,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom
	})

	local mainFrame = New("Frame", {
		Parent = screenGui,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Size = UDim2.fromOffset(defaultW, defaultH),
		Position = UDim2.new(0.5, -defaultW / 2, 0.5, -defaultH / 2)
	})

	New("UICorner", {
		Parent = mainFrame,
		CornerRadius = UDim.new(0, 12)
	})

	New("UIStroke", {
		Parent = mainFrame,
		Thickness = 1,
		Color = Theme.Border
	})

	local topBar = New("Frame", {
		Parent = mainFrame,
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 46)
	})

	New("UICorner", {
		Parent = topBar,
		CornerRadius = UDim.new(0, 12)
	})

	local topFix = New("Frame", {
		Parent = topBar,
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0.5, 0)
	})

	local titleLabel = New("TextLabel", {
		Parent = topBar,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 2),
		Size = UDim2.new(1, -120, 0, 20),
		Font = Enum.Font.GothamBold,
		Text = title,
		TextColor3 = Theme.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	})

	local subtitleLabel = New("TextLabel", {
		Parent = topBar,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 14, 0, 22),
		Size = UDim2.new(1, -120, 0, 14),
		Font = Enum.Font.Gotham,
		Text = subtitle,
		TextColor3 = Theme.TextMuted,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd
	})

	local closeBtn = New("TextButton", {
		Parent = topBar,
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -34, 0, 9),
		Size = UDim2.new(0, 24, 0, 24),
		Font = Enum.Font.GothamBold,
		Text = "×",
		TextColor3 = Theme.TextMuted,
		TextSize = 20,
		AutoButtonColor = false
	})

	local body = New("Frame", {
		Parent = mainFrame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 46),
		Size = UDim2.new(1, 0, 1, -46)
	})

	local sidebar = New("Frame", {
		Parent = body,
		BackgroundColor3 = Theme.Section,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 160, 1, 0)
	})

	local sidebarCorner = New("UICorner", {
		Parent = sidebar,
		CornerRadius = UDim.new(0, 0)
	})

	local tabPadding = New("UIPadding", {
		Parent = sidebar,
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8)
	})

	local tabList = New("UIListLayout", {
		Parent = sidebar,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6)
	})

	local content = New("Frame", {
		Parent = body,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 160, 0, 0),
		Size = UDim2.new(1, -160, 1, 0)
	})

	local resizeGrip = New("TextButton", {
		Parent = mainFrame,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -6, 1, -2),
		Size = UDim2.new(0, 18, 0, 18),
		Text = "◢",
		Font = Enum.Font.GothamBold,
		TextColor3 = Theme.TextMuted,
		TextSize = 12,
		AutoButtonColor = false,
		ZIndex = 20
	})

	local floatingButton
	local showFloating = config.MobileButton ~= false and (UserInputService.TouchEnabled or config.ForceFloatingButton)

	local windowWidth = defaultW
	local windowHeight = defaultH
	local userSized = false
	local topBarHeight = 46
	local activeTab = nil
	local tabCount = 0

	local function applyLayout(w, h, recenter)
		windowWidth = w
		windowHeight = h
		mainFrame.Size = UDim2.fromOffset(w, h)
		if recenter then
			mainFrame.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)
		end
		local sidebarWidth = math.clamp(math.floor(w * 0.24), 120, 170)
		sidebar.Size = UDim2.new(0, sidebarWidth, 1, 0)
		content.Position = UDim2.new(0, sidebarWidth, 0, 0)
		content.Size = UDim2.new(1, -sidebarWidth, 1, 0)
	end

	local function setVisible(state)
		mainFrame.Visible = state
	end

	local function toggleVisible()
		setVisible(not mainFrame.Visible)
	end

	if showFloating then
		floatingButton = New("TextButton", {
			Parent = screenGui,
			BackgroundColor3 = Theme.Section,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -18, 1, -110),
			Size = UDim2.new(0, 46, 0, 46),
			AutoButtonColor = false,
			Text = "≡",
			Font = Enum.Font.GothamBold,
			TextColor3 = Theme.Text,
			TextSize = 18,
			ZIndex = 25
		})

		New("UICorner", {
			Parent = floatingButton,
			CornerRadius = UDim.new(1, 0)
		})

		New("UIStroke", {
			Parent = floatingButton,
			Thickness = 1,
			Color = Theme.Border
		})

		MakeDraggable(floatingButton, floatingButton)
		floatingButton.Activated:Connect(toggleVisible)
	end

	MakeDraggable(mainFrame, topBar)
	MakeResizable(mainFrame, resizeGrip, Vector2.new(UserInputService.TouchEnabled and 320 or 520, UserInputService.TouchEnabled and 280 or 360), function(w, h)
		userSized = true
		applyLayout(w, h, false)
	end)

	applyLayout(defaultW, defaultH, true)

	local function refreshTabs()
		if activeTab then
			activeTab.Page.Visible = true
		end
	end

	closeBtn.Activated:Connect(function()
		screenGui:Destroy()
	end)

	local keyConnection
	keyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == keybind then
			toggleVisible()
		end
	end)

	local WindowAPI = {}

	function WindowAPI:SetVisible(state)
		setVisible(state)
	end

	function WindowAPI:Toggle()
		toggleVisible()
	end

	function WindowAPI:SetSize(w, h)
		if typeof(w) == "Vector2" then
			h = w.Y
			w = w.X
		end
		if type(w) == "table" then
			h = w.Y or w[2]
			w = w.X or w[1]
		end
		w = tonumber(w) or windowWidth
		h = tonumber(h) or windowHeight
		userSized = true
		applyLayout(math.max(100, w), math.max(100, h), false)
	end

	function WindowAPI:Notify(config2)
		local nTitle = type(config2) == "table" and (config2.Title or "Notification") or "Notification"
		local nMsg = type(config2) == "table" and (config2.Message or config2.Text or "") or ""
		local duration = type(config2) == "table" and (config2.Duration or 4) or 4

		local notif = New("Frame", {
			Parent = notifyHolder,
			BackgroundColor3 = Theme.Section,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y
		})

		New("UICorner", {
			Parent = notif,
			CornerRadius = UDim.new(0, 10)
		})

		New("UIStroke", {
			Parent = notif,
			Thickness = 1,
			Color = Theme.Border
		})

		local notifTitle = New("TextLabel", {
			Parent = notif,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 14, 0, 8),
			Size = UDim2.new(1, -28, 0, 18),
			Font = Enum.Font.GothamBold,
			Text = nTitle,
			TextColor3 = Theme.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y
		})

		local notifMsg = New("TextLabel", {
			Parent = notif,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 14, 0, 28),
			Size = UDim2.new(1, -28, 0, 0),
			Font = Enum.Font.Gotham,
			Text = nMsg,
			TextColor3 = Theme.TextMuted,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y
		})

		task.delay(duration, function()
			if notif and notif.Parent then
				Tween(notif, {BackgroundTransparency = 0.15}, 0.15)
				task.wait(0.05)
				notif:Destroy()
			end
		end)
	end

	function WindowAPI:CreateTab(tabConfig)
		tabCount += 1

		local tabName = type(tabConfig) == "string" and tabConfig or (tabConfig.Name or tabConfig.Title or "Tab")
		local tabIcon = type(tabConfig) == "table" and tabConfig.Icon or nil

		local tabButton = New("TextButton", {
			Parent = sidebar,
			BackgroundColor3 = Theme.Element,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 38),
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = tabCount
		})

		New("UICorner", {
			Parent = tabButton,
			CornerRadius = UDim.new(0, 8)
		})

		local indicator = New("Frame", {
			Parent = tabButton,
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 0.5, -9),
			Size = UDim2.new(0, 3, 0, 18),
			BackgroundTransparency = 1
		})

		New("UICorner", {
			Parent = indicator,
			CornerRadius = UDim.new(1, 0)
		})

		local labelX = tabIcon and 34 or 12
		local labelWidth = tabIcon and -40 or -20

		local tabLabel = New("TextLabel", {
			Parent = tabButton,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, labelX, 0, 0),
			Size = UDim2.new(1, labelWidth, 1, 0),
			Font = Enum.Font.Gotham,
			Text = tabName,
			TextColor3 = Theme.TextMuted,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd
		})

		local tabIconLabel
		if tabIcon then
			tabIconLabel = New("ImageLabel", {
				Parent = tabButton,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0.5, -8),
				Size = UDim2.new(0, 16, 0, 16),
				Image = tabIcon,
				ImageColor3 = Theme.TextMuted
			})
		end

		local tabPage = New("ScrollingFrame", {
			Parent = content,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = false,
			Size = UDim2.new(1, 0, 1, 0),
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Border,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.None
		})

		local pagePadding = New("UIPadding", {
			Parent = tabPage,
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
			PaddingTop = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 12)
		})

		local pageLayout = New("UIListLayout", {
			Parent = tabPage,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10)
		})

		pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			tabPage.CanvasSize = UDim2.fromOffset(0, pageLayout.AbsoluteContentSize.Y + 24)
		end)

		local function activate()
			if activeTab then
				activeTab.Page.Visible = false
				Tween(activeTab.Button, {BackgroundTransparency = 1}, 0.15)
				Tween(activeTab.Indicator, {BackgroundTransparency = 1}, 0.15)
				Tween(activeTab.Label, {TextColor3 = Theme.TextMuted}, 0.15)
				if activeTab.Icon then
					Tween(activeTab.Icon, {ImageColor3 = Theme.TextMuted}, 0.15)
				end
			end

			activeTab = {
				Button = tabButton,
				Indicator = indicator,
				Label = tabLabel,
				Icon = tabIconLabel,
				Page = tabPage
			}

			tabPage.Visible = true
			Tween(tabButton, {BackgroundTransparency = 0.5}, 0.15)
			Tween(indicator, {BackgroundTransparency = 0}, 0.15)
			Tween(tabLabel, {TextColor3 = Theme.Text}, 0.15)
			if tabIconLabel then
				Tween(tabIconLabel, {ImageColor3 = Theme.Text}, 0.15)
			end
		end

		tabButton.Activated:Connect(activate)

		tabButton.MouseEnter:Connect(function()
			if activeTab and activeTab.Button == tabButton then
				return
			end
			Tween(tabButton, {BackgroundTransparency = 0.6}, 0.15)
		end)

		tabButton.MouseLeave:Connect(function()
			if activeTab and activeTab.Button == tabButton then
				return
			end
			Tween(tabButton, {BackgroundTransparency = 1}, 0.15)
		end)

		if not activeTab then
			task.defer(activate)
		end

		local TabAPI = {}

		function TabAPI:CreateSection(sectionConfig)
			local sectionName = type(sectionConfig) == "string" and sectionConfig or (sectionConfig.Name or sectionConfig.Title or "Section")

			local sectionFrame = New("Frame", {
				Parent = tabPage,
				BackgroundColor3 = Theme.Section,
				BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 0)
			})

			New("UICorner", {
				Parent = sectionFrame,
				CornerRadius = UDim.new(0, 10)
			})

			New("UIStroke", {
				Parent = sectionFrame,
				Thickness = 1,
				Color = Theme.Border
			})

			local sectionTitle = New("TextLabel", {
				Parent = sectionFrame,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 10),
				Size = UDim2.new(1, -24, 0, 18),
				Font = Enum.Font.GothamBold,
				Text = string.upper(sectionName),
				TextColor3 = Theme.TextDark,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left
			})

			local sectionLine = New("Frame", {
				Parent = sectionFrame,
				BackgroundColor3 = Theme.Border,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 12, 0, 32),
				Size = UDim2.new(1, -24, 0, 1)
			})

			local sectionBody = New("Frame", {
				Parent = sectionFrame,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 0, 38),
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y
			})

			local sectionPadding = New("UIPadding", {
				Parent = sectionBody,
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
				PaddingTop = UDim.new(0, 6),
				PaddingBottom = UDim.new(0, 10)
			})

			local sectionList = New("UIListLayout", {
				Parent = sectionBody,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6)
			})

			local SectionAPI = {}

			function SectionAPI:Button(config2, callback)
				local text = "Button"
				local desc = nil
				local cb = callback or function() end

				if type(config2) == "table" then
					text = config2.Title or config2.Name or "Button"
					desc = config2.Description or config2.Desc
					cb = config2.Callback or cb
				else
					text = tostring(config2)
				end

				local height = desc and 58 or 42

				local btn = New("TextButton", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					Size = UDim2.new(1, 0, 0, height)
				})

				New("UICorner", {
					Parent = btn,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = btn,
					Thickness = 1,
					Color = Theme.Border
				})

				local titleLbl = New("TextLabel", {
					Parent = btn,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, desc and 7 or 0),
					Size = UDim2.new(1, -24, 0, desc and 20 or 42),
					Font = Enum.Font.GothamBold,
					Text = text,
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local descLbl
				if desc then
					descLbl = New("TextLabel", {
						Parent = btn,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 12, 0, 28),
						Size = UDim2.new(1, -24, 0, 18),
						Font = Enum.Font.Gotham,
						Text = tostring(desc),
						TextColor3 = Theme.TextMuted,
						TextSize = 10,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd
					})
				end

				btn.Activated:Connect(function()
					cb()
				end)

				btn.MouseEnter:Connect(function()
					Tween(btn, {BackgroundColor3 = Theme.ElementHover}, 0.15)
					Tween(stroke, {Color = Theme.BorderHover}, 0.15)
				end)

				btn.MouseLeave:Connect(function()
					Tween(btn, {BackgroundColor3 = Theme.Element}, 0.15)
					Tween(stroke, {Color = Theme.Border}, 0.15)
				end)

				btn.MouseButton1Down:Connect(function()
					Tween(btn, {BackgroundColor3 = Theme.ElementActive}, 0.08)
				end)

				btn.MouseButton1Up:Connect(function()
					Tween(btn, {BackgroundColor3 = Theme.ElementHover}, 0.08)
				end)

				return {
					SetText = function(newText)
						titleLbl.Text = tostring(newText)
					end,
					SetDescription = function(newDesc)
						if descLbl then
							descLbl.Text = tostring(newDesc or "")
						end
					end,
					Destroy = function()
						btn:Destroy()
					end
				}
			end

			function SectionAPI:Toggle(config2, defaultState, callback)
				local text = "Toggle"
				local desc = nil
				local state = false
				local cb = callback or function() end

				if type(config2) == "table" then
					text = config2.Title or config2.Name or "Toggle"
					desc = config2.Description or config2.Desc
					state = config2.Default or false
					cb = config2.Callback or cb
				else
					text = tostring(config2)
					state = defaultState or false
				end

				local height = desc and 60 or 44

				local toggleBtn = New("TextButton", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					Size = UDim2.new(1, 0, 0, height)
				})

				New("UICorner", {
					Parent = toggleBtn,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = toggleBtn,
					Thickness = 1,
					Color = Theme.Border
				})

				local titleLbl = New("TextLabel", {
					Parent = toggleBtn,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, desc and 7 or 0),
					Size = UDim2.new(1, -78, 0, desc and 20 or 44),
					Font = Enum.Font.GothamBold,
					Text = text,
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local descLbl
				if desc then
					descLbl = New("TextLabel", {
						Parent = toggleBtn,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 12, 0, 29),
						Size = UDim2.new(1, -78, 0, 18),
						Font = Enum.Font.Gotham,
						Text = tostring(desc),
						TextColor3 = Theme.TextMuted,
						TextSize = 10,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd
					})
				end

				local switchBg = New("Frame", {
					Parent = toggleBtn,
					BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 50, 50),
					BorderSizePixel = 0,
					Position = UDim2.new(1, -52, 0.5, -10),
					Size = UDim2.new(0, 40, 0, 20)
				})

				New("UICorner", {
					Parent = switchBg,
					CornerRadius = UDim.new(1, 0)
				})

				local knob = New("Frame", {
					Parent = switchBg,
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					Position = state and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2),
					Size = UDim2.new(0, 16, 0, 16)
				})

				New("UICorner", {
					Parent = knob,
					CornerRadius = UDim.new(1, 0)
				})

				local function update()
					Tween(switchBg, {BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 50, 50)}, 0.15)
					Tween(knob, {Position = state and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2)}, 0.15)
					cb(state)
				end

				toggleBtn.Activated:Connect(function()
					state = not state
					update()
				end)

				toggleBtn.MouseEnter:Connect(function()
					Tween(toggleBtn, {BackgroundColor3 = Theme.ElementHover}, 0.15)
					Tween(stroke, {Color = Theme.BorderHover}, 0.15)
				end)

				toggleBtn.MouseLeave:Connect(function()
					Tween(toggleBtn, {BackgroundColor3 = Theme.Element}, 0.15)
					Tween(stroke, {Color = Theme.Border}, 0.15)
				end)

				if state then
					cb(state)
				end

				return {
					Set = function(newState)
						state = not not newState
						update()
					end,
					Get = function()
						return state
					end
				}
			end

			function SectionAPI:Input(config2, placeholder, callback)
				local text = "Input"
				local desc = nil
				local place = "Enter text..."
				local value = ""
				local cb = callback or function() end

				if type(config2) == "table" then
					text = config2.Title or config2.Name or "Input"
					desc = config2.Description or config2.Desc
					place = config2.Placeholder or place
					value = config2.Default or ""
					cb = config2.Callback or cb
				else
					text = tostring(config2)
					place = placeholder or place
				end

				local height = desc and 86 or 66

				local inputFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, height)
				})

				New("UICorner", {
					Parent = inputFrame,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = inputFrame,
					Thickness = 1,
					Color = Theme.Border
				})

				local titleLbl = New("TextLabel", {
					Parent = inputFrame,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, 7),
					Size = UDim2.new(1, -24, 0, 18),
					Font = Enum.Font.GothamBold,
					Text = text,
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local descLbl
				if desc then
					descLbl = New("TextLabel", {
						Parent = inputFrame,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 12, 0, 25),
						Size = UDim2.new(1, -24, 0, 16),
						Font = Enum.Font.Gotham,
						Text = tostring(desc),
						TextColor3 = Theme.TextMuted,
						TextSize = 10,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd
					})
				end

				local boxY = desc and 46 or 30

				local boxBg = New("Frame", {
					Parent = inputFrame,
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					BorderSizePixel = 0,
					Position = UDim2.new(0, 12, 0, boxY),
					Size = UDim2.new(1, -24, 0, 28)
				})

				New("UICorner", {
					Parent = boxBg,
					CornerRadius = UDim.new(0, 6)
				})

				local boxStroke = New("UIStroke", {
					Parent = boxBg,
					Thickness = 1,
					Color = Color3.fromRGB(40, 40, 40)
				})

				local textBox = New("TextBox", {
					Parent = boxBg,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 8, 0, 0),
					Size = UDim2.new(1, -16, 1, 0),
					Font = Enum.Font.Gotham,
					Text = tostring(value),
					PlaceholderText = place,
					PlaceholderColor3 = Color3.fromRGB(90, 90, 90),
					TextColor3 = Theme.Text,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false
				})

				textBox.Focused:Connect(function()
					Tween(boxStroke, {Color = Theme.Accent}, 0.15)
				end)

				textBox.FocusLost:Connect(function()
					Tween(boxStroke, {Color = Color3.fromRGB(40, 40, 40)}, 0.15)
					cb(textBox.Text)
				end)

				return {
					Set = function(newText)
						textBox.Text = tostring(newText or "")
					end,
					Get = function()
						return textBox.Text
					end,
					Focus = function()
						textBox:CaptureFocus()
					end
				}
			end

