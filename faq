					})
				end

				local bodyLabel = New("TextLabel", {
					Parent = paraFrame,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					Font = Enum.Font.Gotham,
					Text = tostring(text),
					TextColor3 = color,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
					AutomaticSize = Enum.AutomaticSize.Y
				})

				return {
					Set = function(newText)
						bodyLabel.Text = tostring(newText)
					end,
					SetColor = function(newColor)
						bodyLabel.TextColor3 = newColor
					end
				}
			end

			function SectionAPI:Separator(text)
				local sepFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, text and 24 or 10)
				})

				if text then
					New("Frame", {
						Parent = sepFrame,
						BackgroundColor3 = Theme.Border,
						BorderSizePixel = 0,
						Position = UDim2.new(0, 0, 0.5, 0),
						Size = UDim2.new(0.35, 0, 0, 1)
					})

					New("Frame", {
						Parent = sepFrame,
						BackgroundColor3 = Theme.Border,
						BorderSizePixel = 0,
						Position = UDim2.new(0.65, 0, 0.5, 0),
						Size = UDim2.new(0.35, 0, 0, 1)
					})

					New("TextLabel", {
						Parent = sepFrame,
						BackgroundTransparency = 1,
						Position = UDim2.new(0.35, 0, 0, 0),
						Size = UDim2.new(0.3, 0, 1, 0),
						Font = Enum.Font.GothamBold,
						Text = tostring(text),
						TextColor3 = Theme.TextDark,
						TextSize = 10,
						TextXAlignment = Enum.TextXAlignment.Center
					})
				else
					New("Frame", {
						Parent = sepFrame,
						BackgroundColor3 = Theme.Border,
						BorderSizePixel = 0,
						Position = UDim2.new(0, 8, 0.5, 0),
						Size = UDim2.new(1, -16, 0, 1)
					})
				end
			end

			function SectionAPI:Keybind(titleText, defaultKey, callback)
				local key = defaultKey or Enum.KeyCode.K
				local cb = callback or function() end
				local listening = false
				local captureConnection = nil

				local keyFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 42)
				})

				New("UICorner", {
					Parent = keyFrame,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = keyFrame,
					Thickness = 1,
					Color = Theme.Border
				})

				New("TextLabel", {
					Parent = keyFrame,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, 0),
					Size = UDim2.new(1, -86, 1, 0),
					Font = Enum.Font.GothamBold,
					Text = tostring(titleText),
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local keyBtn = New("TextButton", {
					Parent = keyFrame,
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					BorderSizePixel = 0,
					Position = UDim2.new(1, -72, 0.5, -12),
					Size = UDim2.new(0, 60, 0, 24),
					AutoButtonColor = false,
					Font = Enum.Font.GothamBold,
					Text = key.Name,
					TextColor3 = Theme.TextMuted,
					TextSize = 10
				})

				New("UICorner", {
					Parent = keyBtn,
					CornerRadius = UDim.new(0, 6)
				})

				New("UIStroke", {
					Parent = keyBtn,
					Thickness = 1,
					Color = Color3.fromRGB(60, 60, 60)
				})

				keyBtn.Activated:Connect(function()
					if listening then
						return
					end
					listening = true
					keyBtn.Text = "..."
					keyBtn.TextColor3 = Theme.Accent

					if captureConnection then
						captureConnection:Disconnect()
					end

					captureConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
						if gameProcessed then
							return
						end
						if input.UserInputType == Enum.UserInputType.Keyboard then
							if input.KeyCode ~= Enum.KeyCode.Escape then
								key = input.KeyCode
							end
							keyBtn.Text = key.Name
							keyBtn.TextColor3 = Theme.TextMuted
							listening = false
							if captureConnection then
								captureConnection:Disconnect()
								captureConnection = nil
							end
						end
					end)
				end)

				local runConnection
				runConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
					if gameProcessed or listening then
						return
					end
					if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
						cb()
					end
				end)

				return {
					Set = function(newKey)
						if typeof(newKey) == "EnumItem" then
							key = newKey
							keyBtn.Text = key.Name
						end
					end,
					Get = function()
						return key
					end
				}
			end

			function SectionAPI:Slider(config2, min, max, default, callback)
				local text = "Slider"
				local minimum = 0
				local maximum = 100
				local value = 0
				local decimals = false
				local cb = callback or function() end

				if type(config2) == "table" then
					text = config2.Title or config2.Name or "Slider"
					minimum = config2.Min or 0
					maximum = config2.Max or 100
					value = config2.Default or minimum
					decimals = config2.Decimals or false
					cb = config2.Callback or cb
				else
					text = tostring(config2)
					minimum = min or 0
					maximum = max or 100
					value = default or minimum
				end

				local range = maximum - minimum
				if range == 0 then
					range = 1
				end

				local sliderFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 62)
				})

				New("UICorner", {
					Parent = sliderFrame,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = sliderFrame,
					Thickness = 1,
					Color = Theme.Border
				})

				New("TextLabel", {
					Parent = sliderFrame,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, 7),
					Size = UDim2.new(1, -76, 0, 18),
					Font = Enum.Font.GothamBold,
					Text = text,
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local function formatValue(v)
					if decimals then
						return string.format("%.2f", v)
					end
					return tostring(math.floor(v + 0.5))
				end

				local valueBox = New("TextBox", {
					Parent = sliderFrame,
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					BorderSizePixel = 0,
					Position = UDim2.new(1, -60, 0, 6),
					Size = UDim2.new(0, 48, 0, 22),
					Font = Enum.Font.GothamBold,
					Text = formatValue(value),
					TextColor3 = Theme.Text,
					TextSize = 11,
					ClearTextOnFocus = false
				})

				New("UICorner", {
					Parent = valueBox,
					CornerRadius = UDim.new(0, 6)
				})

				New("UIStroke", {
					Parent = valueBox,
					Thickness = 1,
					Color = Color3.fromRGB(60, 60, 60)
				})

				local track = New("Frame", {
					Parent = sliderFrame,
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					BorderSizePixel = 0,
					Position = UDim2.new(0, 12, 0, 38),
					Size = UDim2.new(1, -24, 0, 6)
				})

				New("UICorner", {
					Parent = track,
					CornerRadius = UDim.new(1, 0)
				})

				local fill = New("Frame", {
					Parent = track,
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
					Size = UDim2.new(math.clamp((value - minimum) / range, 0, 1), 0, 1, 0)
				})

				New("UICorner", {
					Parent = fill,
					CornerRadius = UDim.new(1, 0)
				})

				local knob = New("Frame", {
					Parent = fill,
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					Position = UDim2.new(1, -8, 0.5, -8),
					Size = UDim2.new(0, 16, 0, 16)
				})

				New("UICorner", {
					Parent = knob,
					CornerRadius = UDim.new(1, 0)
				})

				local dragging = false

				local function setFromScale(scale)
					scale = math.clamp(scale, 0, 1)
					local raw = minimum + (maximum - minimum) * scale
					if decimals then
						value = raw
					else
						value = math.floor(raw + 0.5)
					end
					valueBox.Text = formatValue(value)
					fill.Size = UDim2.new(scale, 0, 1, 0)
					cb(value)
				end

				local function setFromInput(input)
					local scale = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
					setFromScale(scale)
				end

				track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						setFromInput(input)
					end
				end)

				knob.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						setFromInput(input)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				valueBox.FocusLost:Connect(function()
					local n = tonumber(valueBox.Text)
					if n then
						value = math.clamp(n, minimum, maximum)
						if not decimals then
							value = math.floor(value + 0.5)
						end
						local scale = (value - minimum) / range
						valueBox.Text = formatValue(value)
						fill.Size = UDim2.new(math.clamp(scale, 0, 1), 0, 1, 0)
						cb(value)
					else
						valueBox.Text = formatValue(value)
					end
				end)

				cb(value)

				return {
					Set = function(newValue)
						newValue = tonumber(newValue) or minimum
						value = math.clamp(newValue, minimum, maximum)
						if not decimals then
							value = math.floor(value + 0.5)
						end
						local scale = (value - minimum) / range
						valueBox.Text = formatValue(value)
						fill.Size = UDim2.new(math.clamp(scale, 0, 1), 0, 1, 0)
						cb(value)
					end,
					Get = function()
						return value
					end
				}
			end

			function SectionAPI:Dropdown(config2, options, default, callback)
				local text = "Dropdown"
				local opts = {}
				local def = nil
				local multi = false
				local searchable = false
				local cb = callback or function() end

				if type(config2) == "table" then
					text = config2.Title or config2.Name or "Dropdown"
					opts = config2.Options or {}
					def = config2.Default
					multi = config2.Multi or false
					searchable = config2.Searchable or false
					cb = config2.Callback or cb
				else
					text = tostring(config2)
					opts = options or {}
					def = default
				end

				local selected
				if multi then
					selected = type(def) == "table" and def or {}
				else
					selected = def ~= nil and def or opts[1]
				end

				local open = false
				local optionButtons = {}

				local dropFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 40),
					ClipsDescendants = true
				})

				New("UICorner", {
					Parent = dropFrame,
					CornerRadius = UDim.new(0, 8)
				})

				local stroke = New("UIStroke", {
					Parent = dropFrame,
					Thickness = 1,
					Color = Theme.Border
				})

				local header = New("TextButton", {
					Parent = dropFrame,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 40),
					Text = "",
					AutoButtonColor = false
				})

				New("TextLabel", {
					Parent = header,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 12, 0, 0),
					Size = UDim2.new(0.48, 0, 1, 0),
					Font = Enum.Font.GothamBold,
					Text = text,
					TextColor3 = Theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local valueLabel = New("TextLabel", {
					Parent = header,
					BackgroundTransparency = 1,
					Position = UDim2.new(0.48, 0, 0, 0),
					Size = UDim2.new(0.42, -14, 1, 0),
					Font = Enum.Font.Gotham,
					TextColor3 = Theme.TextMuted,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Right,
					TextTruncate = Enum.TextTruncate.AtEnd
				})

				local arrow = New("TextLabel", {
					Parent = header,
					BackgroundTransparency = 1,
					Position = UDim2.new(1, -20, 0, 0),
					Size = UDim2.new(0, 16, 1, 0),
					Font = Enum.Font.GothamBold,
					Text = "⌄",
					TextColor3 = Theme.TextMuted,
					TextSize = 18,
					TextXAlignment = Enum.TextXAlignment.Center
				})

				local contentFrame = New("Frame", {
					Parent = dropFrame,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 0, 0, 42),
					Size = UDim2.new(1, 0, 0, 0),
					Visible = false,
					AutomaticSize = Enum.AutomaticSize.Y
				})

				local contentLayout = New("UIListLayout", {
					Parent = contentFrame,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 6)
				})

				local searchBox
				local listFrame = New("ScrollingFrame", {
					Parent = contentFrame,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 0),
					ScrollBarThickness = 3,
					ScrollBarImageColor3 = Theme.Border,
					CanvasSize = UDim2.new(0, 0, 0, 0)
				})

				local listLayout = New("UIListLayout", {
					Parent = listFrame,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 4)
				})

				local listPadding = New("UIPadding", {
					Parent = listFrame,
					PaddingLeft = UDim.new(0, 0),
					PaddingRight = UDim.new(0, 0),
					PaddingTop = UDim.new(0, 0),
					PaddingBottom = UDim.new(0, 0)
				})

				local function updateCanvas()
					listFrame.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 4)
				end

				listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

				local function displayText()
					if multi then
						if #selected == 0 then
							return "Select..."
						elseif #selected == 1 then
							return tostring(selected[1])
						else
							return tostring(#selected) .. " selected"
						end
					else
						return selected ~= nil and tostring(selected) or "Select..."
					end
				end

				local function rebuild()
					for _, child in ipairs(optionButtons) do
						if child and child.Parent then
							child:Destroy()
						end
					end
					table.clear(optionButtons)

					local query = ""
					if searchable and searchBox then
						query = string.lower(searchBox.Text or "")
					end

					local visibleOptions = {}

					for _, option in ipairs(opts) do
						local textValue = tostring(option)
						if query == "" or string.find(string.lower(textValue), query, 1, true) then
							table.insert(visibleOptions, option)
						end
					end

					local listHeight = math.min(math.max(#visibleOptions * 34, 34), 160)
					listFrame.Size = UDim2.new(1, 0, 0, listHeight)

					for _, option in ipairs(visibleOptions) do
						local optionText = tostring(option)
						local selectedNow = multi and table.find(selected, option) ~= nil or selected == option

						local optBtn = New("TextButton", {
							Parent = listFrame,
							BackgroundColor3 = selectedNow and Theme.ElementActive or Color3.fromRGB(44, 44, 44),
							BorderSizePixel = 0,
							Size = UDim2.new(1, 0, 0, 30),
							AutoButtonColor = false,
							Text = ""
						})

						New("UICorner", {
							Parent = optBtn,
							CornerRadius = UDim.new(0, 6)
						})

						local optLabel = New("TextLabel", {
							Parent = optBtn,
							BackgroundTransparency = 1,
							Position = UDim2.new(0, 10, 0, 0),
							Size = UDim2.new(1, -20, 1, 0),
							Font = Enum.Font.Gotham,
							Text = optionText,
							TextColor3 = selectedNow and Theme.Text or Color3.fromRGB(205, 205, 205),
							TextSize = 11,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextTruncate = Enum.TextTruncate.AtEnd
						})

						optBtn.Activated:Connect(function()
							if multi then
								local index = table.find(selected, option)
								if index then
									table.remove(selected, index)
								else
									table.insert(selected, option)
								end
								valueLabel.Text = displayText()
								cb(selected, option)
								rebuild()
							else
								selected = option
								valueLabel.Text = displayText()
								cb(option)
								open = false
								contentFrame.Visible = false
								arrow.Rotation = 0
								dropFrame.ClipsDescendants = true
							end
						end)

						optBtn.MouseEnter:Connect(function()
							if multi and table.find(selected, option) or (not multi and selected == option) then
								return
							end
							Tween(optBtn, {BackgroundColor3 = Color3.fromRGB(52, 52, 52)}, 0.15)
						end)

						optBtn.MouseLeave:Connect(function()
							if multi and table.find(selected, option) or (not multi and selected == option) then
								Tween(optBtn, {BackgroundColor3 = Theme.ElementActive}, 0.15)
							else
								Tween(optBtn, {BackgroundColor3 = Color3.fromRGB(44, 44, 44)}, 0.15)
							end
						end)

						table.insert(optionButtons, optBtn)
					end

					valueLabel.Text = displayText()
				end

				if searchable then
					searchBox = New("TextBox", {
						Parent = contentFrame,
						BackgroundColor3 = Color3.fromRGB(24, 24, 24),
						BorderSizePixel = 0,
						Size = UDim2.new(1, 0, 0, 28),
						Font = Enum.Font.Gotham,
						Text = "",
						PlaceholderText = "Search...",
						PlaceholderColor3 = Color3.fromRGB(95, 95, 95),
						TextColor3 = Theme.Text,
						TextSize = 11,
						ClearTextOnFocus = false
					})

					New("UICorner", {
						Parent = searchBox,
						CornerRadius = UDim.new(0, 6)
					})

					New("UIStroke", {
						Parent = searchBox,
						Thickness = 1,
						Color = Color3.fromRGB(58, 58, 58)
					})

					searchBox:GetPropertyChangedSignal("Text"):Connect(function()
						if open then
							rebuild()
						end
					end)
				end

				header.Activated:Connect(function()
					open = not open
					contentFrame.Visible = open
					dropFrame.ClipsDescendants = not open
					arrow.Rotation = open and 180 or 0
					if open then
						rebuild()
					end
				end)

				if type(def) ~= "nil" and def ~= "" then
					valueLabel.Text = displayText()
				else
					valueLabel.Text = displayText()
				end

				rebuild()

				local function setSelected(value)
					if multi then
						selected = type(value) == "table" and value or { value }
					else
						selected = value
					end
					valueLabel.Text = displayText()
					if open then
						rebuild()
					end
					cb(selected)
				end

				return {
					Set = setSelected,
					Get = function()
						return selected
					end
				}
			end

			return SectionAPI
		end

		return TabAPI
	end

	refreshTabs()

	return WindowAPI
end

return NaJa
