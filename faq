			function SectionAPI:Paragraph(config2)
				local heading = nil
				local text = ""
				local color = Theme.TextMuted

				if type(config2) == "table" then
					heading = config2.Title or config2.Name
					text = config2.Text or config2.Description or ""
					color = config2.Color or color
				else
					text = tostring(config2)
				end

				local paraFrame = New("Frame", {
					Parent = sectionBody,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y
				})

				New("UICorner", {
					Parent = paraFrame,
					CornerRadius = UDim.new(0, 8)
				})

				New("UIStroke", {
					Parent = paraFrame,
					Thickness = 1,
					Color = Theme.Border
				})

				local innerPadding = New("UIPadding", {
					Parent = paraFrame,
					PaddingLeft = UDim.new(0, 12),
					PaddingRight = UDim.new(0, 12),
					PaddingTop = UDim.new(0, 10),
					PaddingBottom = UDim.new(0, 10)
				})

				local innerLayout = New("UIListLayout", {
					Parent = paraFrame,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 4)
				})

				if heading then
					New("TextLabel", {
						Parent = paraFrame,
