            -- KEYBIND
            function SectionAPI:Keybind(title, defaultKey, callback)
                local key = defaultKey or Enum.KeyCode.K
                local cb = callback or function() end
                local listening = false

                local KeybindFrame = Instance.new("Frame")
                KeybindFrame.Name = title
                KeybindFrame.Parent = SectionContainer
                KeybindFrame.BackgroundColor3 = Theme.Element
                KeybindFrame.Size = UDim2.new(1, 0, 0, 40)

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 6)
                Corner.Parent = KeybindFrame

                local Stroke = Instance.new("UIStroke")
                Stroke.Color = Theme.Border
                Stroke.Thickness = 1
                Stroke.Parent = KeybindFrame

                local TitleLabel = Instance.new("TextLabel")
                TitleLabel.Parent = KeybindFrame
                TitleLabel.BackgroundTransparency = 1
                TitleLabel.Position = UDim2.new(0, 12, 0, 0)
                TitleLabel.Size = UDim2.new(0.6, 0, 1, 0)
                TitleLabel.Font = Enum.Font.GothamBold
                TitleLabel.Text = title
                TitleLabel.TextColor3 = Theme.Text
                TitleLabel.TextSize = 12
                TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

                local KeyDisplay = Instance.new("TextButton")
                KeyDisplay.Parent = KeybindFrame
                KeyDisplay.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                KeyDisplay.Position = UDim2.new(1, -70, 0.5, -12)
                KeyDisplay.Size = UDim2.new(0, 60, 0, 24)
                KeyDisplay.AutoButtonColor = false
                KeyDisplay.Font = Enum.Font.GothamBold
                KeyDisplay.Text = key.Name
                KeyDisplay.TextColor3 = Theme.TextMuted
                KeyDisplay.TextSize = 10

                local KeyCorner = Instance.new("UICorner")
                KeyCorner.CornerRadius = UDim.new(0, 4)
                KeyCorner.Parent = KeyDisplay

                local KeyStroke = Instance.new("UIStroke")
                KeyStroke.Color = Color3.fromRGB(60, 60, 60)
                KeyStroke.Thickness = 1
                KeyStroke.Parent = KeyDisplay

                local inputConnection

                KeyDisplay.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    KeyDisplay.Text = "..."
                    KeyDisplay.TextColor3 = Theme.Accent

                    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                        if gameProcessed then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode == Enum.KeyCode.Escape then
                                KeyDisplay.Text = key.Name
                                KeyDisplay.TextColor3 = Theme.TextMuted
                            else
                                key = input.KeyCode
                                KeyDisplay.Text = key.Name
                                KeyDisplay.TextColor3 = Theme.TextMuted
                            end
                            listening = false
                            if inputConnection then
                                inputConnection:Disconnect()
                                inputConnection = nil
                            end
                        end
                    end)
                end)

                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if gameProcessed or listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
                        cb()
                    end
                end)

                return {
                    Set = function(newKey)
                        key = newKey
                        KeyDisplay.Text = key.Name
                    end,
                    Get = function() return key end
                }
            end

            return SectionAPI
        end

        return TabAPI
    end

    -- Window-level functions
    function WindowAPI:Notify(config)
        local title = type(config) == "table" and (config.Title or "Notification") or "Notification"
        local message = type(config) == "table" and (config.Message or config.Text or "") or ""
        local duration = type(config) == "table" and (config.Duration or 4) or 4

        local NotifFrame = Instance.new("Frame")
        NotifFrame.Parent = ScreenGui
        NotifFrame.BackgroundColor3 = Theme.Section
        NotifFrame.BorderSizePixel = 0
        NotifFrame.Position = UDim2.new(1, -330, 1, -80)
        NotifFrame.Size = UDim2.new(0, 300, 0, 60)

        local NotifCorner = Instance.new("UICorner")
        NotifCorner.CornerRadius = UDim.new(0, 8)
        NotifCorner.Parent = NotifFrame

        local NotifStroke = Instance.new("UIStroke")
        NotifStroke.Color = Theme.Border
        NotifStroke.Thickness = 1
        NotifStroke.Parent = NotifFrame

        local NotifTitle = Instance.new("TextLabel")
        NotifTitle.Parent = NotifFrame
        NotifTitle.BackgroundTransparency = 1
        NotifTitle.Position = UDim2.new(0, 15, 0, 8)
        NotifTitle.Size = UDim2.new(1, -30, 0, 18)
        NotifTitle.Font = Enum.Font.GothamBold
        NotifTitle.Text = title
        NotifTitle.TextColor3 = Theme.Text
        NotifTitle.TextSize = 13
        NotifTitle.TextXAlignment = Enum.TextXAlignment.Left

        local NotifMsg = Instance.new("TextLabel")
        NotifMsg.Parent = NotifFrame
        NotifMsg.BackgroundTransparency = 1
        NotifMsg.Position = UDim2.new(0, 15, 0, 28)
        NotifMsg.Size = UDim2.new(1, -30, 0, 24)
        NotifMsg.Font = Enum.Font.Gotham
        NotifMsg.Text = message
        NotifMsg.TextColor3 = Theme.TextMuted
        NotifMsg.TextSize = 11
        NotifMsg.TextXAlignment = Enum.TextXAlignment.Left
        NotifMsg.TextWrapped = true

        NotifFrame.Position = UDim2.new(1, 20, 1, -80)
        Tween(NotifFrame, {Position = UDim2.new(1, -330, 1, -80)}, 0.4)

        task.delay(duration, function()
            Tween(NotifFrame, {Position = UDim2.new(1, 20, 1, -80)}, 0.3)
            task.wait(0.35)
            NotifFrame:Destroy()
        end)
    end

    function WindowAPI:Toggle()
        uiVisible = not uiVisible
        MainFrame.Visible = uiVisible
    end

    function WindowAPI:Destroy()
        ScreenGui:Destroy()
    end

    return WindowAPI
