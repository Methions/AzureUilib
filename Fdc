                TextBoxBg.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                TextBoxBg.Position = UDim2.new(0, 12, 0, 32)
                TextBoxBg.Size = UDim2.new(1, -24, 0, 28)

                local BgCorner = Instance.new("UICorner")
