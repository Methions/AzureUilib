                local ItemsList = Instance.new("UIListLayout")
                ItemsList.Parent = ItemsContainer
                ItemsList.SortOrder = Enum.SortOrder.LayoutOrder
                ItemsList.Padding = UDim.new(0, 2)

                local function updateText()
                    if multi then
                        SelectedLabel.Text = #selected > 0 and table.concat(selected, ", ") or "Select..."
                    else
                        SelectedLabel.Text = tostring(selected)
                    end
                end

                local function toggleDropdown()
                    isOpen = not isOpen
                    local targetHeight = isOpen and (40 + 35 + #opts * 32 + 10) or 40
                    Tween(DropdownFrame, {Size = UDim2.new(1, 0, 0, math.min(targetHeight, 250))})
                    Tween(Arrow, {Rotation = isOpen and 180 or 0})
                end

                for i, option in ipairs(opts) do
                    local ItemBtn = Instance.new("TextButton")
                    ItemBtn.Parent = ItemsContainer
                    ItemBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                    ItemBtn.Size = UDim2.new(1, 0, 0, 30)
                    ItemBtn.AutoButtonColor = false
                    ItemBtn.Text = ""

                    local ItemCorner = Instance.new("UICorner")
                    ItemCorner.CornerRadius = UDim.new(0, 4)
                    ItemCorner.Parent = ItemBtn

                    local ItemLabel = Instance.new("TextLabel")
                    ItemLabel.Parent = ItemBtn
                    ItemLabel.BackgroundTransparency = 1
                    ItemLabel.Size = UDim2.new(1, -10, 1, 0)
                    ItemLabel.Position = UDim2.new(0, 10, 0, 0)
                    ItemLabel.Font = Enum.Font.Gotham
                    ItemLabel.Text = option
                    ItemLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
                    ItemLabel.TextSize = 11
                    ItemLabel.TextXAlignment = Enum.TextXAlignment.Left

                    local isSelected = multi and table.find(selected, option) or selected == option
                    if isSelected then
                        ItemBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
                        ItemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end

                    ItemBtn.MouseEnter:Connect(function()
                        if (multi and not table.find(selected, option)) or (not multi and selected ~= option) then
                            Tween(ItemBtn, {BackgroundColor3 = Color3.fromRGB(55, 55, 55)})
                        end
                    end)
                    ItemBtn.MouseLeave:Connect(function()
                        local sel = multi and table.find(selected, option) or selected == option
                        Tween(ItemBtn, {BackgroundColor3 = sel and Color3.fromRGB(60, 60, 80) or Color3.fromRGB(45, 45, 45)})
                    end)
                    ItemBtn.MouseButton1Click:Connect(function()
                        if multi then
                            local found = table.find(selected, option)
                            if found then
                                table.remove(selected, found)
                                Tween(ItemBtn, {BackgroundColor3 = Color3.fromRGB(45, 45, 45)})
                                ItemLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
                            else
                                table.insert(selected, option)
                                Tween(ItemBtn, {BackgroundColor3 = Color3.fromRGB(60, 60, 80)})
                                ItemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            end
                            cb(selected, option)
                        else
                            selected = option
                            for _, child in ipairs(ItemsContainer:GetChildren()) do
                                if child:IsA("TextButton") then
                                    Tween(child, {BackgroundColor3 = Color3.fromRGB(45, 45, 45)})
                                    child:FindFirstChildOfClass("TextLabel").TextColor3 = Color3.fromRGB(200, 200, 200)
                                end
                            end
                            Tween(ItemBtn, {BackgroundColor3 = Color3.fromRGB(60, 60, 80)})
                            ItemLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                            cb(option)
                            toggleDropdown()
                        end
                        updateText()
                    end)
                end

                local ClickArea = Instance.new("TextButton")
                ClickArea.Parent = DropdownFrame
                ClickArea.BackgroundTransparency = 1
                ClickArea.Size = UDim2.new(1, 0, 0, 40)
                ClickArea.Text = ""
                ClickArea.MouseButton1Click:Connect(toggleDropdown)

                return {
                    Set = function(value)
                        if multi then
                            selected = type(value) == "table" and value or {value}
                        else
                            selected = value
                        end
                        updateText()
                    end,
                    Get = function() return selected end
                }
            end

            -- SLIDER
            function SectionAPI:Slider(config, min, max, default, callback)
                local title, minimum, maximum, def, decimals, cb
                if type(config) == "table" then
                    title = config.Title or config.Name or "Slider"
                    minimum = config.Min or 0
                    maximum = config.Max or 100
                    def = config.Default or minimum
                    decimals = config.Decimals or false
                    cb = config.Callback or function() end
                else
                    title = tostring(config)
                    minimum = min or 0
                    maximum = max or 100
                    def = default or minimum
                    decimals = false
                    cb = callback or function() end
                end

                local value = def
                local dragging = false

                local SliderFrame = Instance.new("Frame")
                SliderFrame.Name = title
                SliderFrame.Parent = SectionContainer
                SliderFrame.BackgroundColor3 = Theme.Element
                SliderFrame.Size = UDim2.new(1, 0, 0, 55)

                local Corner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 6)
                Corner.Parent = SliderFrame

                local Stroke = Instance.new("UIStroke")
                Stroke.Color = Theme.Border
                Stroke.Thickness = 1
                Stroke.Parent = SliderFrame

                local TitleLabel = Instance.new("TextLabel")
                TitleLabel.Parent = SliderFrame
                TitleLabel.BackgroundTransparency = 1
                TitleLabel.Position = UDim2.new(0, 12, 0, 8)
                TitleLabel.Size = UDim2.new(0.6, 0, 0, 18)
                TitleLabel.Font = Enum.Font.GothamBold
                TitleLabel.Text = title
                TitleLabel.TextColor3 = Theme.Text
                TitleLabel.TextSize = 12
                TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

                local ValueBox = Instance.new("TextBox")
                ValueBox.Parent = SliderFrame
                ValueBox.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                ValueBox.Position = UDim2.new(1, -55, 0, 6)
                ValueBox.Size = UDim2.new(0, 45, 0, 22)
                ValueBox.Font = Enum.Font.GothamBold
                ValueBox.Text = tostring(def)
                ValueBox.TextColor3 = Color3.fromRGB(255, 255, 255)
                ValueBox.TextSize = 11
                ValueBox.ClearTextOnFocus = false

                local ValueCorner = Instance.new("UICorner")
                ValueCorner.CornerRadius = UDim.new(0, 4)
                ValueCorner.Parent = ValueBox

                local Track = Instance.new("Frame")
                Track.Parent = SliderFrame
                Track.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                Track.Position = UDim2.new(0, 12, 0, 35)
                Track.Size = UDim2.new(1, -24, 0, 6)

                local TrackCorner = Instance.new("UICorner")
                TrackCorner.CornerRadius = UDim.new(1, 0)
                TrackCorner.Parent = Track

                local Fill = Instance.new("Frame")
                Fill.Parent = Track
                Fill.BackgroundColor3 = Theme.Accent
                Fill.Size = UDim2.new((def - minimum) / (maximum - minimum), 0, 1, 0)

                local FillCorner = Instance.new("UICorner")
                FillCorner.CornerRadius = UDim.new(1, 0)
                FillCorner.Parent = Fill

                local Knob = Instance.new("Frame")
                Knob.Parent = Fill
                Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                Knob.Position = UDim2.new(1, -8, 0.5, -8)
                Knob.Size = UDim2.new(0, 16, 0, 16)

                local KnobCorner = Instance.new("UICorner")
                KnobCorner.CornerRadius = UDim.new(1, 0)
                KnobCorner.Parent = Knob

                local function formatValue(val)
                    if decimals then
                        return string.format("%.2f", val)
                    else
                        return tostring(math.floor(val + 0.5))
                    end
                end

                local function updateValue(input)
                    local scale = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    value = minimum + (maximum - minimum) * scale
                    ValueBox.Text = formatValue(value)
                    Fill.Size = UDim2.new(scale, 0, 1, 0)
                    cb(value)
                end

                Knob.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        updateValue(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        updateValue(input)
                    end
                end)
                ValueBox.FocusLost:Connect(function()
                    local num = tonumber(ValueBox.Text)
                    if num then
                        value = math.clamp(num, minimum, maximum)
                        ValueBox.Text = formatValue(value)
                        Fill.Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0)
                        cb(value)
                    else
                        ValueBox.Text = formatValue(value)
                    end
                end)

                return {
                    Set = function(newValue)
                        value = math.clamp(newValue, minimum, maximum)
                        ValueBox.Text = formatValue(value)
                        Fill.Size = UDim2.new((value - minimum) / (maximum - minimum), 0, 1, 0)
                        cb(value)
                    end,
                    Get = function() return value end
                }
            end

