                local TextBox = Instance.new("TextBox")
                TextBox.Parent = TextBoxBg
                TextBox.BackgroundTransparency = 1
                TextBox.Size = UDim2.new(1, -16, 1, 0)
                TextBox.Position = UDim2.new(0, 8, 0, 0)
                TextBox.Font = Enum.Font.Gotham
                TextBox.PlaceholderText = place
                TextBox.PlaceholderColor3 = Color3.fromRGB(80, 80, 80)
                TextBox.Text = def
                TextBox.TextColor3 = Theme.Text
                TextBox.TextSize = 11
                TextBox.TextXAlignment = Enum.TextXAlignment.Left
                TextBox.ClearTextOnFocus = false

                TextBox.Focused:Connect(function()
                    Tween(BgStroke, {Color = Theme.Accent})
                end)
                TextBox.FocusLost:Connect(function(enterPressed)
                    Tween(BgStroke, {Color = Color3.fromRGB(40, 40, 40)})
                    if enterPressed then
                        cb(TextBox.Text)
                    end
                end)

                return {
                    Set = function(text) TextBox.Text = text end,
                    Get = function() return TextBox.Text end,
                    Focus = function() TextBox:CaptureFocus() end
                }
            end

